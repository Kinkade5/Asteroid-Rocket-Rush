# Node deps for the Netlify leaderboard function (installed by Netlify at
# deploy time, and locally if you run `npm install` / `netlify dev`).
node_modules/

# Netlify CLI local state
.netlify/

# Claude Code session state and git worktrees — machine-local, never shared.
.claude/

# Generated byte-for-byte mirror of claude.md (the cross-tool agent-instructions
# standard). Tracking it would duplicate claude.md and let the two drift —
# claude.md stays the single source of truth.
AGENTS.md

# --- Folded in from git.gitignore (2026-07-25) -------------------------------
# These patterns sat in a stray file named `git.gitignore` since April, which
# git never reads, so none of them were actually in effect. Nothing tracked
# matched them, so adopting them here changes no existing file.

# OS cruft
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp

# Local-only scratch dirs — kept out of the Netlify deploy.
/drafts/
/notes/
